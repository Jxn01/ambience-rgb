[Unit]
Description=Turn local RGB hardware off at shutdown
Documentation=https://github.com/Jxn01/ambience-rgb
DefaultDependencies=no
After=basic.target
Before=shutdown.target
Conflicts=shutdown.target
RequiresMountsFor=@INSTALL_DIR@

[Service]
Type=oneshot
RemainAfterExit=yes
# Does nothing at boot. The work is in ExecStop, which systemd runs at shutdown.
ExecStart=/bin/true
# A SYSTEM unit, because the user session is already gone by the time this runs
# -- the same reason matterlights' own lights-off layer is a system unit.
#
# It always reaches the Corsair Commander Core, which is driven directly over
# hidraw and which root can open. It reaches the OpenRGB devices too IF that
# server is still up at this point in the shutdown; when it is not, those have
# already been blacked by the user daemon's own SIGTERM handler. Either way
# something has written black. This is the belt to that braces.
ExecStop=@INSTALL_DIR@/.venv/bin/python -m ambience_rgb off
TimeoutStopSec=20
Environment=AMBIENCE_RGB_CONFIG=@INSTALL_DIR@/config.example.toml

[Install]
WantedBy=multi-user.target
