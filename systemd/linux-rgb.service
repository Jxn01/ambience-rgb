[Unit]
Description=Ambient screen-to-light sync for local RGB hardware
Documentation=https://github.com/Jxn01/linux-rgb
PartOf=graphical-session.target
After=graphical-session.target linux-rgb-openrgb.service
# Wants, not Requires: the Commander Core is driven by our own driver and works
# perfectly well with no OpenRGB server at all. A dead server should cost the
# motherboard and RAM, not the AIO.
Wants=linux-rgb-openrgb.service

[Service]
Type=simple
WorkingDirectory=@INSTALL_DIR@
ExecStart=@INSTALL_DIR@/.venv/bin/python -m linux_rgb run
Restart=on-failure
RestartSec=5
# Long enough for the daemon to write black to every device on the way out.
# Killing it sooner leaves the hardware on its last frame, which then drifts
# back to the firmware pattern a few seconds later and looks like a crash.
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=graphical-session.target
